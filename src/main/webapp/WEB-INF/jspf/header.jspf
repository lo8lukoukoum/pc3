<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>小爱交易网站 - <c:out value="${not empty pageTitle ? pageTitle : '欢迎'}" /></title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
    <%-- Placeholder for page-specific CSS --%>
    <c:if test="${not empty pageSpecificStyles}">
        <style type="text/css">
            ${pageSpecificStyles}
        </style>
    </c:if>
</head>
<body>
    <header>
        <div class="container">
            <div id="branding">
                <h1><a href="${pageContext.request.contextPath}/index.jsp">小爱交易网站</a></h1>
            </div>
            <nav>
                <ul>
                    <li><a href="${pageContext.request.contextPath}/index.jsp">首页</a></li>
                    <li><a href="${pageContext.request.contextPath}/products">商品列表</a></li>
                    <li><a href="${pageContext.request.contextPath}/cart?action=view">购物车 <c:if test="${not empty sessionScope.cartItemCount && sessionScope.cartItemCount > 0}"><span class="cart-count">(${sessionScope.cartItemCount})</span></c:if></a></li>
                    <c:choose>
                        <c:when test="${empty sessionScope.loggedInUser}">
                            <li><a href="${pageContext.request.contextPath}/login.jsp">登录</a></li>
                            <li><a href="${pageContext.request.contextPath}/register.jsp">注册</a></li>
                        </c:when>
                        <c:otherwise>
                            <li><span>欢迎, <c:out value="${sessionScope.loggedInUser.username}" />!</span></li>
                            <li><a href="${pageContext.request.contextPath}/profile">个人中心</a></li>
                            <c:if test="${sessionScope.loggedInUser.role == 'admin'}">
                                <li><a href="${pageContext.request.contextPath}/admin/dashboard.jsp">管理后台</a></li>
                            </c:if>
                            <li><a href="${pageContext.request.contextPath}/logout">退出</a></li>
                        </c:otherwise>
                    </c:choose>
                </ul>
            </nav>
            <div id="search-bar">
                <form action="${pageContext.request.contextPath}/products" method="GET">
                    <input type="text" name="searchTerm" placeholder="搜索商品..." value="<c:out value='${param.searchTerm}'/>">
                    <button type="submit">搜索</button>
                </form>
            </div>
        </div>
    </header>
    
    <div class="container page-content"> <%-- This container wraps the main content of each page --%>
        <%-- Display session messages (success, error, warning) --%>
        <c:if test="${not empty sessionScope.successMessage}">
            <div class="alert alert-success" role="alert">
                <c:out value="${sessionScope.successMessage}"/>
            </div>
            <c:remove var="successMessage" scope="session"/>
        </c:if>
        <c:if test="${not empty sessionScope.errorMessage}">
            <div class="alert alert-danger" role="alert">
                <c:out value="${sessionScope.errorMessage}"/>
            </div>
            <c:remove var="errorMessage" scope="session"/>
        </c:if>
        <c:if test="${not empty sessionScope.warningMessage}">
            <div class="alert alert-warning" role="alert">
                <c:out value="${sessionScope.warningMessage}"/>
            </div>
            <c:remove var="warningMessage" scope="session"/>
        </c:if>
        
        <%-- Display request messages (typically for form validation errors on forward) --%>
        <c:if test="${not empty requestScope.errorMessage}">
            <div class="alert alert-danger" role="alert">
                <c:out value="${requestScope.errorMessage}"/>
            </div>
            <%-- No need to remove from request scope, it's per-request --%>
        </c:if>
        <c:if test="${not empty requestScope.successMessage}">
            <div class="alert alert-success" role="alert">
                <c:out value="${requestScope.successMessage}"/>
            </div>
        </c:if>
        
        <%-- The main content of the specific page will start after this in actual JSPs --%>
